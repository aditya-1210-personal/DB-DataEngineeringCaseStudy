mortgage_pipeline:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'MORTGAGE_PIPELINE_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'MORTGAGE_DB') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'MORTGAGE_WH') }}"
      schema: SILVER
      threads: 4
      client_session_keep_alive: false
